# docpin 环境变量配置
# 复制此文件为 .env 并修改

# JWT 密钥（必填，生产环境必须修改）
JWT_SECRET=change-me-to-a-secure-random-string

# HMAC 密钥（必填，用于日志签名和电子签名）
HMAC_KEY=change-me-to-another-random-string

# JWT token 有效期（秒），默认900=15分钟
JWT_TTL=900

# Refresh token 有效期（秒），默认7200=2小时
REFRESH_TTL=7200

# 数据库路径（可选）
# DB_PATH=data.db

# API 文档开关（生产环境建议关闭）
# SHOW_DOCS=false
